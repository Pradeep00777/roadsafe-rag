# Slim build for small free hosts (Render free tier: 512 MB RAM).
# Uses ONNX embeddings (fastembed) instead of PyTorch + sentence-transformers.
FROM python:3.12-slim

ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    EMBEDDER=fastembed \
    EMBEDDING_MODEL=${EMBEDDING_MODEL} \
    FASTEMBED_CACHE_PATH=/app/.fastembed \
    INDEX_DIR=/app/data/index

COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt

COPY src ./src
COPY scripts ./scripts

# Download the report and build the index. This also caches the embedding model in the image.
RUN python scripts/download_data.py \
    && python -m roadsafe_rag.ingest --pdf data/raw/road-accidents-in-india-2024.pdf \
    && rm -rf data/raw

# Render provides $PORT.
CMD uvicorn roadsafe_rag.api:app --host 0.0.0.0 --port ${PORT:-8000}
